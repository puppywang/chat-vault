{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "ChatVault ChatGPT Sync",
  "version": "0.14.0",
  "description": "把当前打开的 ChatGPT 对话同步到本地 ChatVault（仅发往 127.0.0.1，不经任何第三方）",
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatVault 同步",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
